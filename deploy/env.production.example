# Renderを使う場合、これらは render.yaml のBlueprintが自動で設定するので、
# このファイルを直接使う必要はない。ANTHROPIC_API_KEYだけはRenderダッシュボードの
# Environmentタブで手動入力する(秘密情報のためBlueprintに書けない)。
#
# Render以外(VPS等)に手動でデプロイする場合の参考として残す。

ANTHROPIC_API_KEY=

# 開発環境とは別の値を生成すること:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (Renderのrender.yamlを使う場合は generateValue により自動生成される)
SESSION_SECRET=

# 永続データ(SQLite DB)の保存先。コード本体とは独立した永続ボリュームを指す。
# Renderの場合は render.yaml の disk.mountPath と合わせて /var/data。
DATA_DIR=/var/data
