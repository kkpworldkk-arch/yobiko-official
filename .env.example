# Anthropic API key for the /api/tutor endpoint (console.anthropic.com).
# Without this set, the endpoint falls back to a templated demo response.
ANTHROPIC_API_KEY=

# Secret used to sign login session cookies. Generate your own per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required — the app throws if this is missing. Never reuse the same value across environments.
SESSION_SECRET=
